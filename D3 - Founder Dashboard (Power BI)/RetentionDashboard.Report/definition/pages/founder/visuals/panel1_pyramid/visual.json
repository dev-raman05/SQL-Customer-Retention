{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "panel1_pyramid",
  "position": {
    "x": 20,
    "y": 150,
    "z": 4,
    "height": 275,
    "width": 610,
    "tabOrder": 4
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "customers"
                    }
                  },
                  "Property": "value_tier"
                }
              },
              "queryRef": "customers.value_tier",
              "nativeQueryRef": "value_tier",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "customers"
                    }
                  },
                  "Property": "Total LTV Proxy"
                }
              },
              "queryRef": "customers.Total LTV Proxy",
              "nativeQueryRef": "Total LTV Proxy"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Top quartile holds 51.5% of customer value'"
                }
              }
            }
          }
        }
      ]
    }
  }
}